# ==========================================
# AI CAREER TWIN - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Settings
APP_NAME=AI Career Twin
APP_ENV=development
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database (Default: SQLite, for Production use PostgreSQL)
DATABASE_URL=sqlite:///./ai_career_twin.db
# DATABASE_URL=postgresql://user:password@localhost:5432/career_twin_db

# Google Gemini API Key (Optional: system uses intelligent offline fallback if not set)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# GitHub API Token (Optional: increases API rate limits for live scans)
GITHUB_TOKEN=your_github_token_here

# Security
SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_chars
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
